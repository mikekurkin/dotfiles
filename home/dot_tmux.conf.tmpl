##### Performance ############################################################

set -g repeat-time 300

##### Clipboard ##############################################################

set -g set-clipboard on

# Sensible defaults
set -g @plugin 'tmux-plugins/tmux-sensible'

# Better navigation
set -g @plugin 'christoomey/vim-tmux-navigator'

# Session persistence
set -g @plugin 'tmux-plugins/tmux-resurrect'
set -g @plugin 'tmux-plugins/tmux-continuum'

set -g @plugin 'wfxr/tmux-power'

set -g @tmux_power_theme 'snow'

# Plugins are cloned by bootstrap; do not install from a running tmux session.
if-shell 'test -f "$HOME/.tmux/plugins/tmux-sensible/sensible.tmux"' 'run-shell "$HOME/.tmux/plugins/tmux-sensible/sensible.tmux"'
if-shell 'test -f "$HOME/.tmux/plugins/vim-tmux-navigator/vim-tmux-navigator.tmux"' 'run-shell "$HOME/.tmux/plugins/vim-tmux-navigator/vim-tmux-navigator.tmux"'
if-shell 'test -f "$HOME/.tmux/plugins/tmux-resurrect/resurrect.tmux"' 'run-shell "$HOME/.tmux/plugins/tmux-resurrect/resurrect.tmux"'
if-shell 'test -f "$HOME/.tmux/plugins/tmux-continuum/continuum.tmux"' 'run-shell "$HOME/.tmux/plugins/tmux-continuum/continuum.tmux"'
if-shell 'test -f "$HOME/.tmux/plugins/tmux-power/tmux-power.tmux"' 'run-shell "$HOME/.tmux/plugins/tmux-power/tmux-power.tmux"'

set -g status-interval 5
set -g @tmux_power_right_x "#({{ .chezmoi.homeDir }}/.local/bin/dotfiles-tmux-status #{pane_id} #{socket_path})"
