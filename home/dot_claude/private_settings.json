{
  "permissions": {
    "deny": [
      "Bash(git push *)",
      "Read(*.env)",
      "Read(/ai)",
      "Read(*.env*)"
    ]
  },
  "model": "opus",
  "hooks": {},
  "enabledPlugins": {
    "mattpocock-skills@mattpocock": true,
    "superpowers@claude-plugins-official": true,
