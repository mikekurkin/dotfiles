#!/usr/bin/env bash
# sheet - lay a converted library out as one catalogue .skp.
# Rows are part codes, columns are nominal sizes.
set -euo pipefail

HARNESS="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SHARE="${MODELCONV_STATE:-$HOME/.local/share/model-convert}"
mkdir -p "$SHARE"
SU_VER="2025"
OUT=""
GAP="20"
PIPES=1
SCHEME="dn"
BY_SECTION=0
PIPE_LENGTH="300"
PIPE_SIZES="12,15,18,22,28,35,42,54"
PIPE_WALLS="12:1.0,15:1.0,18:1.0,22:1.2,28:1.2,35:1.5,42:1.5,54:1.5"

usage() {
  cat <<'USAGE'
usage: sheet [options] <library-dir>

  -o, --out FILE     output .skp (default: <library-dir>/catalogue.skp)
  -g, --gap MM       spacing between parts, default 20
  -s, --sketchup VER SketchUp version, default 2025
      --scheme NAME  how a size code maps to a column:
                       dn      metric bore  (001204 -> 12, 001622 -> 16)
                       thread  2 digits per port (0004 -> 1/2")
                       number  first run of digits anywhere
                       none    single column
                       re:PAT  regex; first capture group is the key
      --by-section   group rows by part.json "group", with heading rows
      --no-pipes     omit the parametric pipe row
      --pipe-length MM  pipe length shown in the catalogue, default 300
USAGE
}

LIB=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    -o|--out)       OUT="$2"; shift 2 ;;
    -g|--gap)       GAP="$2"; shift 2 ;;
    --no-pipes)     PIPES=0; shift ;;
    --by-section)   BY_SECTION=1; shift ;;
    --scheme)       SCHEME="$2"; shift 2 ;;
    --pipe-length)  PIPE_LENGTH="$2"; shift 2 ;;
    -s|--sketchup)  SU_VER="$2"; shift 2 ;;
    -h|--help)      usage; exit 0 ;;
    *)              LIB="$1"; shift ;;
  esac
done
[[ -d "${LIB:-}" ]] || { usage; exit 2; }
LIB="$(cd "$LIB" && pwd)"
OUT="${OUT:-$LIB/catalogue.skp}"

rm -f "$SHARE/job.json" "$SHARE/job.done" "$SHARE/job.log"

SCHEME="$SCHEME" BY_SECTION="$BY_SECTION" PIPES="$PIPES" PIPE_LENGTH="$PIPE_LENGTH" PIPE_SIZES="$PIPE_SIZES" \
PIPE_WALLS="$PIPE_WALLS" \
python3 - "$LIB" "$OUT" "$GAP" "$SHARE/job.json" <<'PYEOF'
import glob, json, os, re, sys

lib, out, gap, jobfile = sys.argv[1], sys.argv[2], float(sys.argv[3]), sys.argv[4]


MISC = 10 ** 6   # sorts last: codes that fit no scheme

# How a size code maps to a column. Add your own here, or pass a regex.
THREAD_LABELS = {2: '1/4"', 3: '3/8"', 4: '1/2"', 5: '3/4"', 6: '1"',
                 7: '1 1/4"', 8: '1 1/2"', 9: '2"', 10: '2 1/2"', 12: '3"'}


def primary_dn(code):
    """Nominal bore from a metric size code.

    Handles the common shapes seen in plumbing catalogues: a 4-digit bore with
    a trailing thread or wall code (001204 -> 12, 001622 -> 16), a zero-padded
    plug (000015 -> 15), and multi-port codes that lead with the governing
    diameter (302222 -> 30, 162020 -> 16).
    """
    if not code.isdigit():
        return MISC
    if len(code) == 6:
        head = int(code[:4])
        if head == 0:
            return int(code[4:])
        return head if head <= 100 else int(code[:2])
    if len(code) >= 2:
        return int(code[:2])
    return MISC


def primary_thread(code):
    """Thread size from a 2-digit-per-port code (0004 = 1/2", 040504 = 1/2x3/4)."""
    if not code or not code.isdigit():
        return MISC
    if len(code) % 2 == 0:
        for i in range(0, len(code), 2):
            value = int(code[i:i + 2])
            if value:
                return value
        return MISC
    return int(code[:2])


def primary_number(code):
    """First run of digits anywhere in the code - a reasonable generic default."""
    m = re.search(r'\d+', code or '')
    return int(m.group(0)) if m else MISC


SCHEME = os.environ.get('SCHEME', 'dn')

if SCHEME.startswith('re:'):
    # Custom: the first capture group becomes the column key. Numeric groups
    # sort numerically, anything else alphabetically after them.
    _pattern = re.compile(SCHEME[3:])
    _alpha = {}

    def primary(code):
        m = _pattern.search(code or '')
        if not m:
            return MISC
        key = m.group(1) if m.groups() else m.group(0)
        if key.isdigit():
            return int(key)
        return _alpha.setdefault(key, MISC - 1000 + len(_alpha))

    def column_label(value):
        if value == MISC:
            return 'misc'
        for k, v in _alpha.items():
            if v == value:
                return k
        return str(value)

elif SCHEME == 'none':
    def primary(_code):
        return 0

    def column_label(_value):
        return 'all'

else:
    primary = {'dn': primary_dn, 'thread': primary_thread,
               'number': primary_number}.get(SCHEME, primary_dn)

    def column_label(value):
        if value == MISC:
            return 'misc'
        if SCHEME == 'thread':
            return THREAD_LABELS.get(value, 'D%d' % value)
        return str(value)


cells, rows, cols = [], {}, set()
# Row 0 is reserved for pipes, so the catalogue reads pipe-then-fittings.
PIPE_ROW = 0
row_offset = 1 if os.environ.get('PIPES', '1') != '0' else 0
# Gather first, so parts can be ordered by section with a heading row between
# groups. Section comes from part.json's "group".
catalogue = []
for part in sorted(os.listdir(lib)):
    meta_path = os.path.join(lib, part, 'part.json')
    if not os.path.exists(meta_path):
        continue
    with open(meta_path, encoding='utf-8') as fh:
        meta = json.load(fh)
    models = sorted(glob.glob(os.path.join(lib, part, 'skp', '*.skp')))
    if not models:
        continue
    catalogue.append((meta.get('group') or '', part, models))

BY_SECTION = os.environ.get('BY_SECTION', '0') != '0'
catalogue.sort(key=lambda e: (e[0], e[1]) if BY_SECTION else (e[1],))

headings = []
current_section = None
next_row = row_offset
for section, part, models in catalogue:
    if BY_SECTION and section != current_section:
        headings.append({'index': next_row, 'label': '=== %s ===' % section})
        next_row += 1
        current_section = section
    row = next_row
    next_row += 1
    rows[part] = row
    for path in models:
        code = os.path.basename(path)[:-4][len(part) + 1:]
        col = primary(code)
        cols.add(col)
        cells.append({'path': path, 'row': row, 'col': col, 'label': code})

pipes = []
if os.environ.get('PIPES', '1') != '0':
    walls = dict(p.split(':') for p in os.environ['PIPE_WALLS'].split(','))
    for dn in os.environ['PIPE_SIZES'].split(','):
        dn = dn.strip()
        wall = float(walls.get(dn, 1.0))
        pipes.append({
            'dn': float(dn), 'wall': wall,
            'length': float(os.environ['PIPE_LENGTH']), 'segments': 24,
            'code': 'VTi.900.304.%s' % dn.zfill(3), 'name': 'Pipe DN%s' % dn,
            'label': 'DN%s %sx%s' % (dn, dn, wall),
            'row': PIPE_ROW, 'col': int(dn),
        })
        cols.add(int(dn))

job = {
    'mode': 'sheet', 'out': out, 'gap': gap, 'cells': cells, 'pipes': pipes,
    'rows': ([{'index': PIPE_ROW, 'label': 'Pipe'}] if pipes else []) + headings +
            [{'index': i, 'label': '%s  %s' % (p, ' '.join(
                json.load(open(os.path.join(lib, p, 'part.json'), encoding='utf-8'))['name'].split()))}
             for p, i in rows.items()],
    'cols': [{'index': c, 'label': column_label(c)} for c in sorted(cols)],
}
json.dump(job, open(jobfile, 'w'), ensure_ascii=False)
print('sheet: %d components + %d pipes, %d rows (%d section heading(s)) x %d columns'
      % (len(cells), len(pipes), len(rows) + (1 if pipes else 0), len(headings), len(cols)))
PYEOF

PLUGINS="$HOME/Library/Application Support/SketchUp $SU_VER/SketchUp/Plugins"
cp "$HARNESS/sketchup_batch.rb" "$PLUGINS/model_convert_batch.rb"
SU_APP="/Applications/SketchUp $SU_VER/SketchUp.app"
SEED="$SHARE/seed.skp"
if pgrep -f "$SU_APP/Contents/MacOS/SketchUp" >/dev/null; then
  echo "SketchUp is already running - quit it first" >&2; exit 1
fi
open -a "$SU_APP" "$SEED"

echo -n "building sheet"
for _ in $(seq 1 1800); do
  [[ -f "$SHARE/job.done" ]] && break
  sleep 1; echo -n "."
done
echo
cat "$SHARE/job.log" 2>/dev/null
osascript -e "tell application \"SketchUp\" to quit" >/dev/null 2>&1 || true
for _ in $(seq 1 10); do
  pgrep -f "$SU_APP/Contents/MacOS/SketchUp" >/dev/null || break
  sleep 1
done
pgrep -f "$SU_APP/Contents/MacOS/SketchUp" >/dev/null && \
  pkill -9 -f "$SU_APP/Contents/MacOS/SketchUp" || true
[[ -f "$OUT" ]] && ls -la "$OUT" | awk '{print "wrote", $NF, $5, "bytes"}'
